{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "prepare: build dir",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": []
        },
        {
            "label": "build: trading_engine",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/tools/run_backtest/main.cpp",
                "-I",
                "${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/build/trading_engine"
            ],
            "dependsOn": "prepare: build dir",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run: trading_engine",
            "type": "shell",
            "command": "${workspaceFolder}/build/trading_engine",
            "dependsOn": "build: trading_engine",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
